<?xml version="1.0"?>
<package format="3">
  <name>rokae_ros_control</name>
  <version>0.0.1</version>
  <description>ROS2 control node for Rokae robot MoveL relative motion.</description>

  <maintainer email="your_email@example.com">zxl</maintainer>
  <license>Apache-2.0</license>

  <!-- build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <!-- test dependencies，可留可不留 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>